# Copy to proxmox.auto.pkrvars.hcl (git-ignored) and fill in your homelab values.
# The token secret is best supplied via the environment instead of this file:
#   export PKR_VAR_proxmox_api_token='xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
#
# proxmox.auto.pkrvars.hcl is loaded automatically by Packer (*.auto.pkrvars.hcl).

proxmox_url          = "https://pve.example.local:8006/api2/json"
proxmox_api_token_id = "packer@pve!packer"
# proxmox_api_token  = "..."   # prefer PKR_VAR_proxmox_api_token; NEVER commit
proxmox_node         = "pve"
proxmox_insecure     = true
proxmox_storage_pool = "local-lvm"

base_template_name = "ubuntu-2404-cloudimg"
template_name      = "ubuntu-2404-base"
template_vmid      = 9200
